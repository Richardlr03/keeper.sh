# Replace this after Tailscale gives you the private HTTPS address.
BETTER_AUTH_URL=https://keeper.YOUR-TAILNET.ts.net
TRUSTED_ORIGINS=https://keeper.YOUR-TAILNET.ts.net

# Generate three different values on the Azure VM. Never reuse these examples.
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
ENCRYPTION_KEY=replace-with-a-different-openssl-rand-base64-32
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

BLOCK_PRIVATE_RESOLUTION=true
WORKER_CONCURRENCY=1

# Intentionally omitted: WEBHOOK_PUBLIC_URL.
# This private installation uses scheduled polling instead of public webhooks.
